# Application
NODE_ENV=development
PORT=3000
APP_NAME=Modus
APP_URL=http://localhost:3000
API_PREFIX=api/v1

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=modus

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Google SMTP (SSL Secure Port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Modus <no-reply@modus.local>"
