# Name
APP_NAME="Pharmbrew"

# configs
NODE_ENV="development"
PORT=8000
API_PREFIX="api/v1"

# mongo url
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/
DB_NAME=pharmbrew

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Google SMTP (SSL Secure Port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Pharmbrew <no-reply@pharmbrew.com>"
